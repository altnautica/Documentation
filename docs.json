{
  "$schema": "https://mintlify.com/docs.json",
  "name": "ADOS Documentation",
  "theme": "mint",
  "colors": {
    "primary": "#2563EB",
    "light": "#3A82FF",
    "dark": "#1D4ED8"
  },
  "background": {
    "color": {
      "dark": "#0A0A0F",
      "light": "#FFFFFF"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "source": "/fonts/space-grotesk-latin-600-normal.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "source": "/fonts/inter-latin-400-normal.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "mcp"
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "discord",
        "href": "https://discord.gg/uxbvuD4d5q"
      },
      {
        "type": "github",
        "href": "https://github.com/altnautica"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Demo",
      "href": "https://command.altnautica.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/altnautica",
      "discord": "https://discord.gg/uxbvuD4d5q",
      "linkedin": "https://www.linkedin.com/company/altnautica",
      "youtube": "https://www.youtube.com/@altnautica"
    }
  },
  "navigation": {
    "$ref": "./config/navigation.json"
  },
  "redirects": [
    {
      "source": "/drone-agent/vision-nav-features",
      "destination": "/drone-agent/vision-nav-overview",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-getting-started",
      "destination": "/drone-agent/vision-nav-install",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-mode-comparison",
      "destination": "/drone-agent/vision-nav-modes",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-architecture",
      "destination": "/drone-agent/vision-nav-how-it-works",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-fallback-methods",
      "destination": "/drone-agent/vision-nav-how-it-works",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-calibration-math",
      "destination": "/drone-agent/vision-nav-calibration",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-faq",
      "destination": "/drone-agent/vision-nav-troubleshooting",
      "permanent": true
    },
    {
      "source": "/drone-agent/vision-nav-vio",
      "destination": "/drone-agent/vision-nav-modes",
      "permanent": true
    },
    {
      "source": "/mission-control/mavlink-signing",
      "destination": "/drone-agent/mavlink-signing",
      "permanent": true
    },
    {
      "source": "/mission-control/sitl-testing",
      "destination": "/mission-control/simulation",
      "permanent": true
    },
    {
      "source": "/developers/event-hooks-and-bus",
      "destination": "/developers/event-hooks",
      "permanent": true
    },
    {
      "source": "/architecture/contributing-guide",
      "destination": "/getting-started/contributing",
      "permanent": true
    },
    {
      "source": "/developers/contributing-repos",
      "destination": "/getting-started/contributing",
      "permanent": true
    },
    {
      "source": "/mission-control/firmware-comparison",
      "destination": "/reference/firmware-matrix",
      "permanent": true
    }
  ]
}
